load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "srcs",
    srcs = [
        "src/schema.gen.ts",
        "src/viewer.ts",
        "tsconfig.json",
        "viewer.html",
    ],
)

genrule(
    name = "viewer_dist",
    srcs = [
        "src/schema.gen.ts",
        "src/viewer.ts",
        "tsconfig.json",
    ],
    outs = [
        "schema.gen.js",
        "viewer.js",
    ],
    cmd = """
        OUT_DIR=$$(dirname $(location schema.gen.js))
        $(execpath @node//:node) $(execpath @typescript//:tsc) \
            -p $(execpath tsconfig.json) --outDir "$$OUT_DIR"
    """,
    tools = [
        "@node",
        "@typescript//:tsc",
    ],
)

genrule(
    name = "pages_bundle",
    srcs = [
        "viewer.html",
        ":viewer_dist",
    ],
    outs = ["pages_bundle.tar.gz"],
    cmd = """
        GEN_VISUALS=$$(pwd)/$(location //generators:generate_visuals)
        TMP=$$(mktemp -d)
        trap 'rm -rf "$$TMP"' EXIT
        mkdir -p "$$TMP/pages"
        cp $(location viewer.html) $(locations :viewer_dist) "$$TMP/pages/"
        (cd "$$TMP" && "$$GEN_VISUALS" --visuals)
        cp -r $$TMP/output/architecture-visuals/* "$$TMP/pages/"
        tar -czf $@ -C "$$TMP/pages" .
    """,
    tools = ["//generators:generate_visuals"],
)

sh_test(
    name = "viewer_bundle_test",
    srcs = ["run_viewer_bundle_test.sh"],
    args = ["$(location :pages_bundle)"],
    data = [":pages_bundle"],
)
