    deps = ["//lean:shoumei"],
)

lean_binary(
    name = "gen_tests",
    srcs = ["GenTests.lean"],
    data = [":instr_dict"],
    main = "GenTests",
    deps = ["//lean:testgen"],
)

lean_binary(
    name = "gen_benchmarks",
    srcs = ["GenBenchmarks.lean"],
    data = [":instr_dict"],
    main = "GenBenchmarks",
    deps = ["//lean:benchmark_specs"],
)

lean_binary(
    name = "smt2lean",
    srcs = ["Smt2Lean.lean"],
    main = "Smt2Lean",
)

lean_binary(
    name = "sva2lean",
    srcs = ["Sva2Lean.lean"],
    main = "Sva2Lean",
    deps = ["//lean:shoumei"],
)

lean_binary(
    name = "structural_lint",
    srcs = ["StructuralLintMain.lean"],
    main = "StructuralLintMain",
    deps = ["//lean:structural_lint"],
)

lean_binary(
    name = "lean_root",
