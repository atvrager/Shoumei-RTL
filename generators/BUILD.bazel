)

lean_binary(
    name = "project_map",
    srcs = ["ProjectMapMain.lean"],
    main = "ProjectMapMain",
    deps = ["//lean:project_map"],
)

lean_binary(
    name = "gen_testbench",
    srcs = ["GenTestbench.lean"],
    main = "GenTestbench",
    deps = ["//lean:circuits"],
)

lean_binary(
    name = "generate_decoders",
    srcs = ["GenerateDecoders.lean"],
    data = [":instr_dict"],
    main = "GenerateDecoders",
    deps = ["//lean:decoder_gen"],
)

lean_binary(
    name = "generate_sec",
    srcs = ["GenerateSec.lean"],
