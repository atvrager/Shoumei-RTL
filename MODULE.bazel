module(
    name = "shoumei",
    version = "0.1.0",
)

bazel_dep(name = "rules_lean")
archive_override(
    module_name = "rules_lean",
    integrity = "sha256-JDSeR+NQRCuLMMUn+yFPyGD1R2rtVxjWDNlnVGnRKlM=",
    strip_prefix = "rules_lean-2cf9d007003ff73374e0082a82342e3f4723fc65",
    urls = ["https://github.com/atvrager/rules_lean/archive/2cf9d007003ff73374e0082a82342e3f4723fc65.tar.gz"],
)

lean = use_extension("@rules_lean//lean:extensions.bzl", "lean")
lean.toolchain(toolchain_file = "//:lean-toolchain")
use_repo(lean, "lean_toolchains")

register_toolchains("@lean_toolchains//:all")

bazel_dep(name = "rules_foreign_cc", version = "0.16.0")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "rules_verilator", version = "1.1.2")
bazel_dep(name = "verilator", version = "5.046.bcr.5")
bazel_dep(name = "flex", version = "2.6.4.bcr.5")
bazel_dep(name = "bison", version = "3.8.2.bcr.8")
bazel_dep(name = "m4", version = "1.4.21.bcr.4")

# Hermetic external tools for the synthesis and lint steps.
bazel_dep(name = "yosys", version = "0.68.bcr.1")

# Yosys and ABC keep a readline shell.  That shell drags in ncurses and the
# `sed` module, which does not build here.  The scripts run both tools in batch
# mode only.
single_version_override(
    module_name = "yosys",
    patch_strip = 1,
    patches = ["//third_party/patches:yosys-no-readline.patch"],
    version = "0.68.bcr.1",
)

single_version_override(
    module_name = "abc",
    patch_strip = 1,
    patches = ["//third_party/patches:abc-no-readline.patch"],
)

bazel_dep(name = "rules_verilog", version = "1.4.3")
bazel_dep(name = "rules_shell", version = "0.7.1")

register_toolchains("//toolchains/verilator:verilator_toolchain")

# node and typescript compile the viewer bundle.
node_tools = use_extension("//rules:node_tools.bzl", "node_tools_ext")
use_repo(node_tools, "node", "typescript")

# The RISC-V compiler for the ELF tests.
riscv_gcc = use_extension("//rules:riscv_gcc.bzl", "riscv_gcc_ext")
use_repo(riscv_gcc, "riscv_gcc")

register_toolchains("//toolchains/riscv:riscv_gcc")

pdk = use_extension("//rules:pdk.bzl", "pdk_ext")
use_repo(pdk, "orfs_pdk")

lint_tools = use_extension("//rules:lint_tools.bzl", "lint_tools")
use_repo(lint_tools, "ruff", "ty")

# The Python tools the build runs, such as the SystemVerilog elaborator.  A
# pinned lock file keeps them out of the host environment.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.11",
    requirements_lock = "//tools:requirements_lock.txt",
)
use_repo(pip, "pip")
