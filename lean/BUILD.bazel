load("@rules_lean//lean:defs.bzl", "lean_axiom_test", "lean_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Shoumei/Verification/DualRTL.lean",
])

lean_library(
    name = "dsl",
    srcs = ["Shoumei/DSL.lean"],
    extra_flags = ["-DwarningAsError=true"],
)

LINT_SRCS = [
    "Shoumei/Lint/Fix.lean",
    "Shoumei/Lint/Scan.lean",
    "Shoumei/Lint/Style.lean",
]

RISCV_ISA_SRCS = [
    "Shoumei/RISCV/Config.lean",
    "Shoumei/RISCV/Decoder.lean",
    "Shoumei/RISCV/Encoder.lean",
    "Shoumei/RISCV/EncoderProofs.lean",
    "Shoumei/RISCV/ISA.lean",
    "Shoumei/RISCV/Microcode/FallbackTypes.lean",
    "Shoumei/RISCV/Microcode/ZbEmulationLibrary.lean",
    "Shoumei/RISCV/OpTypeGenerated.lean",
    "Shoumei/RISCV/OpcodeParser.lean",
]

TESTGEN_SRCS = [
    "Shoumei/TestGen/AsmEmitter.lean",
    "Shoumei/TestGen/Patterns.lean",
    "Shoumei/TestGen/RandAlphabet.lean",
    "Shoumei/TestGen/RandProgram.lean",
    "Shoumei/TestGen/Rng.lean",
]

BENCHMARK_SRCS = [
    "Shoumei/RISCV/BenchmarkSpecs.lean",
]

lean_library(
    name = "lint",
    srcs = LINT_SRCS,
    extra_flags = ["-DwarningAsError=true"],
)

lean_library(
    name = "riscv_isa",
    srcs = RISCV_ISA_SRCS,
    extra_flags = ["-DwarningAsError=true"],
    deps = [":dsl"],
)

lean_library(
    name = "testgen",
    srcs = TESTGEN_SRCS,
    extra_flags = ["-DwarningAsError=true"],
    deps = [
        ":dsl",
        ":riscv_isa",
    ],
)

lean_library(
    name = "benchmark_specs",
    srcs = BENCHMARK_SRCS,
    extra_flags = ["-DwarningAsError=true"],
    deps = [
        ":dsl",
        ":riscv_isa",
    ],
)

PROOFS_PATTERNS = [
    "**/*Proofs.lean",
    "Shoumei/Circuits/Combinational/ALUBitVecBridge.lean",
    "Shoumei/Circuits/Sequential/Queue1Bridge.lean",
    "Shoumei/Circuits/Sequential/RegisterLemmas.lean",
    "Shoumei/Reflection/ALUSymbolic.lean",
    "Shoumei/Reflection/BitVecPacking.lean",
    "Shoumei/Reflection/BoolExpr.lean",
    "Shoumei/Reflection/CompileCircuit.lean",
    "Shoumei/Reflection/CompileGate.lean",
    "Shoumei/Reflection/FlattenSoundness.lean",
    "Shoumei/Reflection/SequentialCompile.lean",
    "Shoumei/Reflection/SymbolicCompile.lean",
    "Shoumei/Verification/ALU32HierBridge.lean",
    "Shoumei/Verification/CompositionDemos.lean",
    "Shoumei/Verification/DualRTLProofs.lean",
    "Shoumei/Verification/ExportRefinements.lean",
    "Shoumei/Verification/Implements.lean",
    "Shoumei/Verification/ProofManifest.lean",
    "Shoumei/Verification/Refinements.lean",
    "Shoumei/Theorems.lean",
    "Shoumei.lean",
    "Shoumei/All.lean",
]

PROOFS_SRCS = glob(
    PROOFS_PATTERNS,
    allow_empty = True,
    exclude = ["Shoumei/RISCV/EncoderProofs.lean"],
)

CIRCUITS_EXCLUDE = [
    "Shoumei/DSL.lean",
] + LINT_SRCS + RISCV_ISA_SRCS + TESTGEN_SRCS + BENCHMARK_SRCS + PROOFS_PATTERNS

lean_library(
    name = "circuits",
    srcs = glob(
        ["**/*.lean"],
        exclude = CIRCUITS_EXCLUDE,
    ),
    extra_flags = ["-DwarningAsError=true"],
    deps = [
        ":dsl",
        ":riscv_isa",
    ],
)

lean_library(
    name = "shoumei",
    srcs = PROOFS_SRCS,
    extra_flags = ["-DwarningAsError=true"],
    deps = [
        ":benchmark_specs",
        ":circuits",
        ":dsl",
        ":lint",
        ":riscv_isa",
        ":testgen",
    ],
)

filegroup(
    name = "shoumei_srcs",
    srcs = glob(["**/*.lean"]),
)

sh_test(
    name = "lean_root_test",
    srcs = ["lean_root_test.sh"],
    args = ["$(location //generators:generate_all)"],
    data = [
        ":shoumei_srcs",
        "//:known_unbuilt_modules",
        "//generators:generate_all",
    ],
)

sh_test(
    name = "project_map_test",
    srcs = ["project_map_test.sh"],
    args = ["$(location //generators:generate_all)"],
    data = [
        ":shoumei_srcs",
        "//:docs",
        "//generators:generate_all",
    ],
)

lean_axiom_test(
    name = "core_theorems_axiom_test",
    allowed_axioms = [
        "propext",
        "Classical.choice",
        "Quot.sound",
    ],
    theorems = [
        "Shoumei.and_commutative",
        "Shoumei.or_commutative",
        "Shoumei.xor_commutative",
        "Shoumei.not_involution",
    ],
    deps = [":shoumei"],
)

lean_axiom_test(
    name = "logicunit_axiom_test",
    allowed_axioms = [
        "propext",
        "Quot.sound",
    ],
    theorems = [
        "Shoumei.Circuits.Combinational.logicunitN_gates_length",
        "Shoumei.Circuits.Combinational.logicunitN_inputs_length",
        "Shoumei.Circuits.Combinational.logicunitN_outputs_length",
    ],
    deps = [":shoumei"],
)

lean_axiom_test(
    name = "queue_invariants_axiom_test",
    allowed_axioms = [
        "propext",
        "Quot.sound",
    ],
    theorems = [
        "Shoumei.Circuits.Sequential.never_exceeds_capacity",
        "Shoumei.Circuits.Sequential.fifo_single",
        "Shoumei.Circuits.Sequential.empty_has_zero_count",
        "Shoumei.Circuits.Sequential.empty_is_empty",
        "Shoumei.Circuits.Sequential.empty_not_full",
    ],
    deps = [":shoumei"],
)

test_suite(
    name = "axiom_gates",
    tests = [
        ":core_theorems_axiom_test",
        ":logicunit_axiom_test",
        ":queue_invariants_axiom_test",
    ],
)

test_suite(
    name = "integrity_tests",
    tests = [
        ":axiom_gates",
        ":lean_root_test",
        ":project_map_test",
    ],
)
