load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "fst_inspect",
    srcs = ["//:scripts/fst_inspect.cpp"],
    copts = ["-O2"],
    deps = [
        "//third_party:libfst",
    ],
)

sh_test(
    name = "fst_inspect_test",
    srcs = ["run_fst_inspect_test.sh"],
    args = ["$(location :fst_inspect)"],
    data = [":fst_inspect"],
)
