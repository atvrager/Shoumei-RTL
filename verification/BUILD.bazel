genrule(
    name = "pdk_cells_model",
    srcs = [
        "//lean:shoumei_srcs",
        "//third_party:orfs_liberty",
    ],
    outs = ["pdk-cells-model.sv"],
    cmd = "python3 scripts/gen-pdk-cell-models.py --out $@",
    tools = ["//:root_python_scripts"],
)

