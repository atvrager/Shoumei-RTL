# About 250 s on 12 cores, so "medium" (300 s) is too short for a CI runner.
sh_test(
    name = "techmap_equiv_test",
    size = "large",
    srcs = ["run_techmap_equiv.sh"],
    args = [
        "$(rootpath //third_party/tools:yosys)",
        "$(location //:sv)",
        "$(location //:sv_asap7)",
        "$(location //:sv_gf180)",
        "$(location :pdk_cells_model)",
        # Representative modules across adders and logic
        "ALU32",
        "KoggeStoneAdder64NoCin",
        "BrentKungAdder32",
        "CarrySelectAdder32",
    ],
    data = [
        "techmap-equiv.sh",
        "tool_path.sh",
        ":pdk_cells_model",
        "//:root_shell_scripts",
        "//:sv",
        "//:sv_asap7",
        "//:sv_gf180",
        "//third_party/tools:yosys",
        "//third_party/tools:yosys_share",
    ],
)

# One co-simulation test per spec-backed module.  Presubmit runs the two
# busy tables.  `bazel test //verification:spec_equiv_all` runs every module.
SPEC_EQUIV_PRESUBMIT = [
    "BusyTable_W2",
    "FPBusyTable",
]

[
    spec_equiv_test(
        name = "spec_equiv_%s_test" % module,
        cycles = 5000,
        module = module,
        tags = [] if module in SPEC_EQUIV_PRESUBMIT else ["manual"],
    )
    for module in SPEC_EQUIV_MODULES
]

test_suite(
    name = "spec_equiv_test",
    tests = ["spec_equiv_%s_test" % m for m in SPEC_EQUIV_PRESUBMIT],
)

test_suite(
    name = "spec_equiv_all",
    tests = ["spec_equiv_%s_test" % m for m in SPEC_EQUIV_MODULES],
)

