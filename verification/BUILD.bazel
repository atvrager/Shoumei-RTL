    srcs = ["run_techmap_equiv.sh"],
    args = [
        "$(location //:sv)",
        "$(location //:sv_asap7)",
        "$(location //:sv_gf180)",
        "$(location :pdk_cells_model)",
        # Representative modules across adders and logic
        "ALU32",
        "KoggeStoneAdder64NoCin",
        "BrentKungAdder32",
        "CarrySelectAdder32",
    ],
    data = [
        "techmap-equiv.sh",
        ":pdk_cells_model",
        "//:root_shell_scripts",
        "//:sv",
        "//:sv_asap7",
        "//:sv_gf180",
    ],
)

