load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//verification:slang.bzl", "slang_lint_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "slang-lint.py",
])

filegroup(
    name = "verification_scripts",
    srcs = glob(["*.sh"]),
)

filegroup(
    name = "verification_python_scripts",
    srcs = glob(["*.py"]),
)

slang_lint_test(
    name = "slang_lint_test",
    sv = "//:sv",
)

slang_lint_test(
    name = "slang_sram_lint_test",
    sram = True,
    sv = "//:sv",
)

slang_lint_test(
    name = "slang_sec_lint_test",
    lean_sv = "//:sv",
    sv = "//:sv_sec",
)

sh_test(
    name = "shellcheck_test",
    srcs = ["run_shellcheck.sh"],
    args = [
        "$(locations //:root_shell_scripts)",
        "$(locations //testbench:testbench_scripts)",
        "$(locations //toolchains/verilator:scripts)",
        "$(locations :verification_scripts)",
    ],
    data = [
        ":verification_scripts",
        "//:root_shell_scripts",
        "//testbench:testbench_scripts",
        "//toolchains/verilator:scripts",
    ],
)

sh_test(
    name = "py_compile_test",
    srcs = ["run_py_compile.sh"],
    args = [
        "$(locations //:root_python_scripts)",
        "$(locations :verification_python_scripts)",
    ],
    data = [
        ":verification_python_scripts",
        "//:root_python_scripts",
    ],
)

sh_test(
    name = "cppcheck_test",
    srcs = ["run_cppcheck.sh"],
    args = [
        "$(locations //testbench:testbench_cpp_srcs)",
        "$(locations //testbench/tests:test_c_srcs)",
    ],
    data = [
        "//testbench:testbench_cpp_srcs",
        "//testbench/tests:test_c_srcs",
    ],
)

sh_test(
    name = "cell_tables_test",
    srcs = ["run_cell_tables.sh"],
    data = [
        "//:root_python_scripts",
        "//lean:shoumei_srcs",
    ],
)

test_suite(
    name = "linters",
    tests = [
        ":cell_tables_test",
        ":cppcheck_test",
        ":py_compile_test",
        ":shellcheck_test",
        ":slang_lint_test",
        ":slang_sec_lint_test",
        ":slang_sram_lint_test",
    ],
)

sh_test(
    name = "yosys_validate_test",
    srcs = ["run_yosys_validate.sh"],
    args = ["$(location //:sv)"],
    data = [
        "validate-sv.sh",
        "//:sv",
    ],
)

sh_test(
    name = "yosys_dc_lint_test",
    srcs = ["run_yosys_dc_lint.sh"],
    args = [
        "$(location //:sv)",
        "$(location //:generate_all)",
    ],
    data = [
        "dc-lint.sh",
        "//:generate_all",
        "//:root_shell_scripts",
        "//:sv",
    ],
)

sh_test(
    name = "sec_yosys_test",
    srcs = ["run_sec_yosys.sh"],
    args = [
        "$(location //:sv_sec)",
        "$(location //:sv)",
    ],
    data = [
        "sec-verify.sh",
        "//:sv",
        "//:sv_sec",
    ],
)

sh_test(
    name = "sva_verilator_test",
    srcs = ["run_sva_verilator.sh"],
    args = ["$(location //:sv)"],
    data = [
        "//:sv",
    ],
)

sh_test(
    name = "check_sec_specs_test",
    srcs = ["run_check_sec_specs.sh"],
    args = ["$(location //:generate_all)"],
    data = [
        "//:generate_all",
    ],
)

sh_test(
    name = "sec_manifest_test",
    srcs = ["run_sec_manifest.sh"],
    args = ["$(location //:generate_all)"],
    data = [
        "//:generate_all",
    ],
)

sh_test(
    name = "check_wiring_test",
    size = "medium",
    srcs = ["run_check_wiring.sh"],
    args = ["$(location //:generate_all)"],
    data = [
        "//:generate_all",
    ],
)

test_suite(
    name = "formal",
    tests = [
        ":check_sec_specs_test",
        ":check_wiring_test",
        ":sec_manifest_test",
        ":sec_yosys_test",
        ":sva_verilator_test",
        ":yosys_dc_lint_test",
        ":yosys_validate_test",
    ],
)
