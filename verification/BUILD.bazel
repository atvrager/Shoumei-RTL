    name = "slang_lint_test",
    size = "medium",
    srcs = ["slang-lint.py"],
    args = ["$(rootpath //:sv)"],
    data = ["//:sv"],
    main = "slang-lint.py",
    deps = ["@pip//pyslang"],
)

