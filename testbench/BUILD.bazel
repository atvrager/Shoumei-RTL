load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_verilator//verilator:defs.bzl", "verilator_cc_library")
load("//testbench:verilog_tree.bzl", "verilog_tree_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "elf_loader",
    srcs = ["lib/elf_loader.cpp"],
    hdrs = ["lib/elf_loader.h"],
    includes = ["."],
)

cc_library(
    name = "spike_oracle",
    srcs = ["lib/spike_oracle.cpp"],
    hdrs = ["lib/spike_oracle.h"],
    includes = ["."],
    deps = [
        ":elf_loader",
        "//third_party:spike_lib",
    ],
)

verilog_tree_library(
    name = "tb_verilog",
    srcs = [
        "//:sv",
        "//:tb_cpu_sv",
    ],
    top_module = "tb_cpu",
)

verilator_cc_library(
    name = "vtb_cpu",
    module = ":tb_verilog",
    vopts = [
        "-Wno-UNOPTFLAT",
        "-Wno-PINMISSING",
        "-Wno-WIDTHEXPAND",
        "-Wno-WIDTHTRUNC",
        "-Wno-CASEOVERLAP",
        "-Wno-UNUSEDSIGNAL",
        "-Wno-UNUSEDPARAM",
        "-Wno-NULLPORT",
        "-Wno-MULTIDRIVEN",
        "--output-split",
        "5000",
        "--output-split-cfuncs",
        "5000",
        "+define+COSIM_DEBUG",
    ],
)

cc_binary(
    name = "cosim_shoumei",
    srcs = [
        "//:cosim_main",
    ],
    copts = [
        "-std=c++20",
    ],
    deps = [
        ":elf_loader",
        ":spike_oracle",
        ":vtb_cpu",
        "//physical/sim-dpi:sram_dpi",
        "//third_party:spike_lib",
    ],
)

cc_binary(
    name = "sim_shoumei",
    srcs = [
        "//:sim_main",
    ],
    copts = [
        "-std=c++17",
    ],
    deps = [
        ":elf_loader",
        ":vtb_cpu",
        "//physical/sim-dpi:sram_dpi",
    ],
)

verilator_cc_library(
    name = "vtb_cov_cpu",
    module = ":tb_verilog",
    vopts = [
        "-Wno-UNOPTFLAT",
        "-Wno-PINMISSING",
        "-Wno-WIDTHEXPAND",
        "-Wno-WIDTHTRUNC",
        "-Wno-CASEOVERLAP",
        "-Wno-UNUSEDSIGNAL",
        "-Wno-UNUSEDPARAM",
        "-Wno-NULLPORT",
        "-Wno-MULTIDRIVEN",
        "--output-split",
        "5000",
        "--output-split-cfuncs",
        "5000",
        "--coverage-line",
    ],
)

cc_binary(
    name = "sim_shoumei_cov",
    srcs = [
        "//:sim_main",
    ],
    copts = [
        "-std=c++17",
        "-DVM_COVERAGE=1",
    ],
    deps = [
        ":elf_loader",
        ":vtb_cov_cpu",
        "//physical/sim-dpi:sram_dpi",
    ],
)

verilog_tree_library(
    name = "tb_spec_verilog",
    srcs = [
        "//:tb_cpu_sv",
        "//verification:sv_spec",
    ],
    top_module = "tb_cpu",
)

verilator_cc_library(
    name = "vtb_spec_cpu",
    module = ":tb_spec_verilog",
    vopts = [
        "-Wno-UNOPTFLAT",
        "-Wno-PINMISSING",
        "-Wno-WIDTHEXPAND",
        "-Wno-WIDTHTRUNC",
        "-Wno-CASEOVERLAP",
        "-Wno-UNUSEDSIGNAL",
        "-Wno-UNUSEDPARAM",
        "-Wno-NULLPORT",
        "-Wno-MULTIDRIVEN",
        "--output-split",
        "5000",
        "--output-split-cfuncs",
        "5000",
    ],
)

cc_binary(
    name = "sim_spec_shoumei",
    srcs = [
        "//:sim_main",
    ],
    copts = [
        "-std=c++17",
    ],
    deps = [
        ":elf_loader",
        ":vtb_spec_cpu",
        "//physical/sim-dpi:sram_dpi",
    ],
)

test_suite(
    name = "sim_tests",
    tests = [
        "//testbench/tests:sim_tests",
        "//testbench/tests/generated:sim_tests",
    ],
)

test_suite(
    name = "cosim_tests",
    tests = [
        "//testbench/tests:cosim_tests",
        "//testbench/tests/generated:cosim_tests",
    ],
)

test_suite(
    name = "spec_tests",
    tests = [
        "//testbench/tests:spec_tests",
        "//testbench/tests/generated:spec_tests",
    ],
)

test_suite(
    name = "all_tests",
    tests = [
        ":cosim_tests",
        ":sim_tests",
        ":spec_tests",
    ],
)

filegroup(
    name = "testbench_cpp_srcs",
    srcs = glob(
        [
            "*.cpp",
            "cache_model_test/*.cpp",
            "coremark/*.c",
            "coremark/*.h",
            "lib/*.cpp",
            "lib/*.h",
            "riscv-tests/*.h",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "testbench_scripts",
    srcs = glob(["*.sh"]),
)

sh_test(
    name = "cache_conformance_test",
    srcs = ["run_cache_conformance.sh"],
    args = [
        "$(location //:sv)",
        "$(location cache_model_test/cache_conformance.cpp)",
        "$(location //physical/sim-dpi:sram_dpi.c)",
    ],
    data = [
        "cache_model_test/cache_conformance.cpp",
        "//:sv",
        "//physical/sim-dpi:sram_dpi.c",
    ],
)

sh_test(
    name = "coverage_test",
    size = "medium",
    srcs = ["run_coverage_test.sh"],
    args = [
        "$(location :sim_shoumei_cov)",
        "$(location //testbench/tests:addi_test_elf)",
        "$(location //testbench/tests:fence_i_test_elf)",
        "$(location //testbench/tests:pass_test_elf)",
        "$(location //testbench/tests/generated:raw_add_nop0_elf)",
        "$(location //testbench/tests/generated:smoke_elf)",
    ],
    data = [
        ":sim_shoumei_cov",
        "//testbench/tests:addi_test_elf",
        "//testbench/tests:fence_i_test_elf",
        "//testbench/tests:pass_test_elf",
        "//testbench/tests/generated:raw_add_nop0_elf",
        "//testbench/tests/generated:smoke_elf",
    ],
)
